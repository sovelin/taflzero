{
  "name": "taflground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly && tsc-alias",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "4.0.18",
    "jsdom": "^28.1.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "vitest": "^4.0.18"
  }
}
